function Services() {
  const [query, setQuery] = useState("");
  const [selected, setSelected] = useState<string[]>([]);
  const filtered = useMemo(() => {
    return services.filter(s => {
      const matchesQuery = [s.name, s.desc, ...(s.tags||[])].join(" ").toLowerCase().includes(query.toLowerCase());
      const matchesTags = selected.length === 0 || selected.every(t => s.tags.includes(t));
      return matchesQuery && matchesTags;
    });
  }, [query, selected]);

  const allTags = useMemo(() => Array.from(new Set(services.flatMap(s => s.tags))), []);
  const toggleTag = (t: string) => setSelected(prev => prev.includes(t) ? prev.filter(x => x !== t) : [...prev, t]);

  return (
    <section id="uslugi" className="py-16 bg-white">
      <div className="max-w-6xl mx-auto px-4">
        <div className="flex items-end justify-between gap-4">
          <div>
            <h2 className="text-2xl md:text-4xl font-bold tracking-tight">Zakres usług</h2>
            <p className="mt-2 text-slate-700">Wybierz interesujący Cię obszar albo wpisz słowo kluczowe.</p>
          </div>
          <div className="w-full md:w-80">
            <div className="relative">
              <Search className="w-4 h-4 absolute left-3 top-3" />
              <Input value={query} onChange={e => setQuery(e.target.value)} placeholder="Szukaj usługi…" className="pl-9" />
            </div>
          </div>
        </div>

        <div className="mt-4 flex flex-wrap gap-2">
          {allTags.map(t => (
            <label key={t} className={`inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm cursor-pointer ${selected.includes(t) ? 'bg-rose-50 border-rose-200' : ''}`}>
              <Checkbox checked={selected.includes(t)} onCheckedChange={() => toggleTag(t)} />
              <span>{t}</span>
            </label>
          ))}
          {selected.length > 0 && (
            <Button variant="ghost" onClick={() => setSelected([])}>Wyczyść filtry</Button>
          )}
        </div>

        <div className="mt-8 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {filtered.map((s) => (
            <Card key={s.key} className="hover:shadow-lg transition-shadow">
              <CardHeader>
                <div className="flex items-center gap-3">
                  <div className="p-2 rounded-xl bg-rose-50">{s.icon}</div>
                  <CardTitle className="text-xl">{s.name}</CardTitle>
                </div>
                <CardDescription>{s.desc}</CardDescription>
              </CardHeader>
              <CardContent>
                <ul className="list-disc list-inside text-sm text-slate-700 space-y-1">
                  {s.bullets.map((b, i) => (<li key={i}>{b}</li>))}
                </ul>
              </CardContent>
              <CardFooter className="flex justify-between items-center">
                <Badge variant="secondary" className="capitalize">{s.tags[0]}</Badge>
                <Button asChild variant="outline">
                  <a href="#kontakt">Zapytaj o wycenę <ChevronRight className="w-4 h-4 ml-1" /></a>
                </Button>
              </CardFooter>
            </Card>
          ))}
        </div>
      </div>
    </section>
  );
}

