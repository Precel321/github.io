function CookieBanner() {
  const [visible, setVisible] = useState(false);
  const [prefs, setPrefs] = useState({ necessary: true, analytics: false });
  React.useEffect(() => {
    const stored = localStorage.getItem('lumenlex_consent_v1');
    if (!stored) setVisible(true);
    else {
      try { const p = JSON.parse(stored); setPrefs(p); } catch {}
    }
    const onOpen = () => setVisible(true);
    window.addEventListener('lumenlex-open-consent', onOpen);
    return () => window.removeEventListener('lumenlex-open-consent', onOpen);
  }, []);

  const applyConsent = (p) => {
    localStorage.setItem('lumenlex_consent_v1', JSON.stringify(p));
    // Consent Mode v2
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments as any); }
    gtag('consent', 'update', {
      ad_user_data: p.analytics ? 'granted' : 'denied',
      ad_personalization: p.analytics ? 'granted' : 'denied',
      ad_storage: p.analytics ? 'granted' : 'denied',
      analytics_storage: p.analytics ? 'granted' : 'denied'
    });
    if (BRAND.gaId && p.analytics) loadGAOnce(BRAND.gaId);
  };

  const acceptAll = () => { const p = { necessary: true, analytics: true }; setPrefs(p); applyConsent(p); setVisible(false); };
  const rejectAll = () => { const p = { necessary: true, analytics: false }; setPrefs(p); applyConsent(p); setVisible(false); };
  const savePrefs = () => { applyConsent(prefs); setVisible(false); };

  if (!visible) return null;
  return (
    <div className="fixed bottom-4 left-4 right-4 md:left-1/2 md:-translate-x-1/2 md:w-[820px] z-50">
      <Card className="shadow-xl">
        <CardContent className="py-4 px-4 space-y-3">
          <div className="flex items-start gap-3 text-sm text-slate-700">
            <Cookie className="w-5 h-5 mt-0.5" />
            <div>
              <div className="font-medium">Zgody na cookies i analitykę</div>
              <div>Używamy plików niezbędnych oraz – za Twoją zgodą – analitycznych (GA4). Zgody możesz zmienić w stopce.</div>
            </div>
          </div>
          <div className="grid md:grid-cols-2 gap-3 text-sm">
            <label className="flex items-center gap-2"><input type="checkbox" checked readOnly /> Niezbędne (zawsze aktywne)</label>
            <label className="flex items-center gap-2"><input type="checkbox" checked={prefs.analytics} onChange={e=>setPrefs(v=>({...v, analytics:e.target.checked}))}/> Analityczne (GA4)</label>
          </div>
          <div className="flex flex-col md:flex-row gap-2 md:justify-end">
            <Button variant="outline" onClick={rejectAll}>Odrzuć</Button>
            <Button variant="outline" onClick={savePrefs}>Zapisz ustawienia</Button>
            <Button onClick={acceptAll}>Akceptuję wszystkie</Button>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}

// Ładowanie GA4 z Consent Mode — tylko raz
let __gaLoaded = false;
function loadGAOnce(id) {
  if (__gaLoaded) return;
  __gaLoaded = true;
  // default: deny
  (window as any).dataLayer = (window as any).dataLayer || [];
  function gtag(){ (window as any).dataLayer.push(arguments as any); }
  gtag('consent', 'default', {
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    ad_storage: 'denied',
    analytics_storage: 'denied'
  });
  const s = document.createElement('script');
  s.async = true;
  s.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
  document.head.appendChild(s);
  const inline = document.createElement('script');
  inline.innerHTML = `window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${id}', { anonymize_ip: true });`;
  document.head.appendChild(inline);
}

function ConsentManager() {
  React.useEffect(() => {
    // jeśli zgody już zapisane i GA włączone — załaduj GA
    try {
      const stored = JSON.parse(localStorage.getItem('lumenlex_consent_v1') || 'null');
      const analytics = stored?.analytics === true;
      if (BRAND.gaId && analytics) loadGAOnce(BRAND.gaId);
    } catch {}
